# PATHA SARATHI - Edge Capture Module Configuration

# Bus Identification
BUS_ID=BUS_101

# Video Input Source: integer index for webcam (e.g., 0) or relative/absolute path to video file
VIDEO_SOURCE=0

# AI Pipeline Settings
FRAME_SKIP=5
CONFIDENCE_THRESHOLD=0.5
DETECTION_COOLDOWN_FRAMES=30

# GPS Configuration
# Mode: "simulation" or "real"
GPS_MODE=simulation
# Behavior when simulated coordinates are exhausted: "loop" or "hold"
GPS_EXHAUSTION_BEHAVIOR=loop

# Storage & Output Directory (relative to project root or absolute)
OUTPUT_DIR=data

# Backend Ingestion API Endpoint
BACKEND_URL=http://localhost:8000
